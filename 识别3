/**************************************
 * 1. 数据加载与样本整合
 **************************************/
var roi = ee.FeatureCollection("projects/my-project1-477312/assets/anhui_province");

// 整合样本点 (训练标签: 0:森林, 1:竹林, 2:草地)
var forest = ee.FeatureCollection("projects/my-project1-477312/assets/nobanboo_dbs")
  .merge(ee.FeatureCollection("projects/my-project1-477312/assets/forest_samples_ah"))
  .map(function(f){return f.set('class', 0);});

var bamboo = ee.FeatureCollection("projects/my-project1-477312/assets/bamboo_dbs_points")
  .merge(ee.FeatureCollection("projects/my-project1-477312/assets/bamboo_ah"))
  .map(function(f){return f.set('class', 1);});

var grass = ee.FeatureCollection("projects/my-project1-477312/assets/grass_anhui")
  .merge(ee.FeatureCollection("projects/my-project1-477312/assets/grass_samples_ah"))
  .map(function(f){return f.set('class', 2);});

var samples_fc = forest.merge(bamboo).merge(grass);
var year = 2024;

/**************************************
 * 2. 预处理函数 (光谱 + 植被指数)
 **************************************/
var optBands = ['B2','B3','B4','B5','B6','B7','B8','B8A','B11','B12'];

function preprocessS2(img) {
  var scl = img.select('SCL');
  var mask = scl.eq(4).or(scl.eq(5)).or(scl.eq(6)).or(scl.eq(7));
  var spectral = img.select(optBands).updateMask(mask);
  
  var ndvi = spectral.normalizedDifference(['B8', 'B4']).rename('NDVI');
  var evi = spectral.expression('2.5 * ((B8 - B4) / (B8 + 6 * B4 - 7.5 * B2 + 1))', {
    'B8': spectral.select('B8'), 'B4': spectral.select('B4'), 'B2': spectral.select('B2')
  }).rename('EVI');
  var lswi = spectral.normalizedDifference(['B8', 'B11']).rename('LSWI');
  var mtci = spectral.expression('(B6 - B5) / (B5 - B4)', {
    'B6': spectral.select('B6'), 'B5': spectral.select('B5'), 'B4': spectral.select('B4')
  }).rename('MTCI');
  
  return spectral.addBands([ndvi, evi, lswi, mtci]).float();
}

/**************************************
 * 3. 构建多源特征集合
 **************************************/
var s2Col = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate(year + '-01-01', year + '-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
  .map(preprocessS2);

var s2Median = s2Col.median().clip(roi);
var s2Std = s2Col.select(['NDVI', 'MTCI', 'LSWI']).reduce(ee.Reducer.stdDev());

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filterDate(year + '-01-01', year + '-12-31')
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .median().clip(roi);
var s1Ratio = s1.select('VV').divide(s1.select('VH').add(0.0001)).rename('VV_VH_ratio');

var terrain = ee.Algorithms.Terrain(ee.Image("USGS/SRTMGL1_003")).select(['elevation', 'slope']).clip(roi);

var worldCover = ee.Image("ESA/WorldCover/v100/2020").clip(roi);
var landMask = worldCover.neq(80).and(worldCover.neq(50)).and(worldCover.neq(70));

var finalImage = s2Median.addBands(s2Std).addBands(s1.select(['VV','VH']))
  .addBands(s1Ratio).addBands(terrain)
  .updateMask(landMask).float();

/**************************************
 * 4. 采样与分类
 **************************************/
var samples = finalImage.sampleRegions({
  collection: samples_fc,
  properties: ['class'],
  scale: 10,
  tileScale: 4
});

var withRandom = samples.randomColumn('rand');
var train = withRandom.filter(ee.Filter.lt('rand', 0.7));
var test = withRandom.filter(ee.Filter.gte('rand', 0.7));

var classifier = ee.Classifier.smileRandomForest(250).train({
  features: train,
  classProperty: 'class',
  inputProperties: finalImage.bandNames()
});

// 原始分类 (0:森林, 1:竹林, 2:草地)
var rawClassified = finalImage.classify(classifier);

/**************************************
 * 5. 标签重映射与背景填充 (★核心逻辑)
 **************************************/
// 映射逻辑：竹林(1->1), 森林(0->2), 草地(2->3)
// 同时用 unmask(0) 将水体建筑填充为 0
var exportClassified = rawClassified.remap([1, 0, 2], [1, 2, 3])
  .unmask(0)
  .clip(roi)
  .byte();

/**************************************
 * 6. 精度评估与特征分析
 **************************************/
var cm = test.classify(classifier).errorMatrix('class', 'classification');
print('--- 原始标签精度评估 ---');
print('整体精度 (OA):', cm.accuracy());
print('Kappa 系数:', cm.kappa());
print('混淆矩阵:', cm);

var importance = classifier.explain();
print('特征重要性:', importance);

/**************************************
 * 7. 长时序物候分析
 **************************************/
var typical_bamboo = bamboo.first().geometry();
var typical_forest = forest.first().geometry();
var typical_grass = grass.first().geometry();

function createTSChart(region, label, color) {
  return ui.Chart.image.series({
    imageCollection: s2Col.select('NDVI'),
    region: region.buffer(100),
    reducer: ee.Reducer.mean(),
    scale: 10
  }).setOptions({
    title: label + ' 2024 NDVI 物候曲线',
    hAxis: {title: '日期'},
    vAxis: {title: 'NDVI'},
    colors: [color],
    lineWidth: 2,
    pointSize: 3
  });
}

print('--- 长时序物候对比 ---');
print(createTSChart(typical_bamboo, '典型竹林', 'green'));
print(createTSChart(typical_forest, '典型森林', 'brown'));
print(createTSChart(typical_grass, '典型草地', 'orange'));

/**************************************
 * 8. 可视化与导出
 **************************************/
Map.centerObject(roi, 7);

// 调色板映射新标签：0:白(背景), 1:亮绿(竹), 2:深绿(森), 3:黄(草)
var exportPalette = ['#ffffff', '#27ae60', '#1a5e1a', '#f1c40f'];
Map.addLayer(exportClassified, {min: 0, max: 3, palette: exportPalette}, 'Classification_0123');

Export.image.toDrive({
  image: exportClassified,
  description: 'Anhui_Bamboo_Forest_Grass_2024_0123',
  region: roi.geometry().bounds(),
  scale: 10,
  maxPixels: 1e13,
  crs: 'EPSG:4326'
});

/**************************************
 * 9. WorldCover 可视化参考
 **************************************/
var wcPalette = ['006400','ffbb22','ffff4c','f096ff','fa0000','b4b4b4','f0f0f0','0064c8','0096a0','00cf75','fae6a0'];
Map.addLayer(worldCover, {min: 10, max: 100, palette: wcPalette}, 'ESA WorldCover 2020', false);

print('导出说明：0-背景, 1-竹林, 2-森林, 3-草地');
